{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based_state_provider",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "type": "minecraft:simple_state_provider",
          "state": "minecraft:dirt"
        }
      }
    ]
  },
    "ignore_vines": true,
    "minimum_size": {
      "type": "minecraft:two_layers_feature_size",
      "limit": 1,
      "lower_size": 0,
      "upper_size": 2
    },
    "trunk_provider": {
        "type": "minecraft:simple_state_provider",
        "state": "portalcubed:lemon_log"
    },
    "foliage_provider": {
      "type": "minecraft:simple_state_provider",
      "state": "portalcubed:lemon_leaves"
    },
    "trunk_placer": {
      "type": "portalcubed:lemon_trunk_placer",
      "center_height": {
        "min_inclusive": 2,
        "max_inclusive": 2
      },
      "branch_count": {
        "type": "minecraft:uniform",
        "min_inclusive": 2,
        "max_inclusive": 3
      },
      "branch_distance": 2
    },
    "foliage_placer": {
      "type": "minecraft:acacia_foliage_placer",
      "radius": 1,
      "offset": 0
    },
    "decorators": []
}
