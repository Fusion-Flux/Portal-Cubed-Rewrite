{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:context_entity_type",
    "cases": [
      {
        "when": "minecraft:fox",
        "model": {
          "type": "minecraft:model",
          "model": "portalcubed:item/construction_cannon_fox"
        }
      },
      {
        "when": "minecraft:copper_golem",
        "model": {
          "type": "minecraft:model",
          "model": "portalcubed:item/construction_cannon_copper_golem"
        }
      },
      {
        "when": [
          "minecraft:villager",
          "minecraft:witch",
          "minecraft:wandering_trader"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "portalcubed:item/construction_cannon_villager"
        }
      },
      {
        "when": [
          "minecraft:allay",
          "minecraft:vex"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "portalcubed:item/construction_cannon_allay"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:view_entity",
      "on_true": {
        "type": "minecraft:condition",
        "property": "minecraft:has_component",
        "component": "portalcubed:cannon_settings",
        "ignore_default": true,
        "on_true": {
          "type": "minecraft:condition",
          "property": "minecraft:keybind_down",
          "keybind": "key.sneak",
          "on_true": {
            "type": "minecraft:model",
            "model": "portalcubed:item/construction_cannon_configure"
          },
          "on_false": {
            "type": "minecraft:condition",
            "property": "minecraft:keybind_down",
            "keybind": "key.use",
            "on_true": {
              "type": "minecraft:model",
              "model": "portalcubed:item/construction_cannon_place"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "portalcubed:item/construction_cannon_idle"
            }
          }
        },
        "on_false": {
          "type": "minecraft:condition",
          "property": "minecraft:keybind_down",
          "keybind": "key.sneak",
          "on_true": {
            "type": "minecraft:model",
            "model": "portalcubed:item/construction_cannon_startup"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "portalcubed:item/construction_cannon_off"
          }
        }
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "portalcubed:item/construction_cannon_off"
      }
    }
  }
}
