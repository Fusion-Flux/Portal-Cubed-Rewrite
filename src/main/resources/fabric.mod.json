{
  "schemaVersion": 1,
  "id": "portalcubed",
  "version": "${version}",
  "name": "Portal Cubed",
  "description": "A Portal mod for Fabric.",
  "authors": [
    "Fusion Flux",
    "Maximum",
    "TropheusJ",
    "Cart3r"
  ],
  "contact": {
    "sources": "https://github.com/Fusion-Flux/Portal-Cubed-Rewrite",
    "issues": "https://github.com/Fusion-Flux/Portal-Cubed-Rewrite/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/portalcubed/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [ "io.github.fusionflux.portalcubed.PortalCubed" ],
    "client": [ "io.github.fusionflux.portalcubed.PortalCubedClient" ]
  },
  "mixins": [ "portalcubed.mixins.json" ],
  "accessWidener": "portalcubed.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fapi_version}",
    "minecraft": "=${minecraft_version}"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/phys/AABB": [ "io/github/fusionflux/portalcubed/framework/extension/AABBExt" ],
      "net/minecraft/world/phys/HitResult": [ "io/github/fusionflux/portalcubed/framework/extension/HitResultExt" ],
      "net/minecraft/world/phys/Vec3": [ "io/github/fusionflux/portalcubed/framework/extension/Vec3Ext" ],
      "net/minecraft/client/Minecraft": [ "io/github/fusionflux/portalcubed/framework/extension/MinecraftExt" ],
      "net/minecraft/world/entity/player/Player": [ "io/github/fusionflux/portalcubed/framework/extension/PlayerExt" ],
      "net/minecraft/world/level/Level": [ "io/github/fusionflux/portalcubed/framework/extension/LevelExt" ],
      "net/minecraft/server/level/ServerLevel": [ "io/github/fusionflux/portalcubed/framework/extension/ServerLevelExt" ],
      "net/minecraft/client/multiplayer/ClientLevel": [ "io/github/fusionflux/portalcubed/framework/extension/ClientLevelExt" ],
      "net/minecraft/world/entity/Entity": [ "io/github/fusionflux/portalcubed/framework/extension/PortalTeleportationExt", "io/github/fusionflux/portalcubed/framework/extension/DisintegrationExt" ],
      "net/minecraft/client/player/AbstractClientPlayer": [ "io/github/fusionflux/portalcubed/framework/extension/AbstractClientPlayerExt" ],
      "net/minecraft/world/level/block/state/BlockBehaviour\u0024Properties": [ "io/github/fusionflux/portalcubed/framework/extension/BlockBehaviourPropertiesExt" ],
      "net/minecraft/world/level/ClipContext": [ "io/github/fusionflux/portalcubed/framework/extension/ClipContextExt" ],
      "net/minecraft/world/entity/LivingEntity": [ "io/github/fusionflux/portalcubed/framework/extension/LivingEntityExt" ],
      "net/minecraft/client/sounds/ChannelAccess\u0024ChannelHandle": [ "io/github/fusionflux/portalcubed/framework/extension/ChannelHandleExt" ]
    }
  }
}
